@startuml uc_03_compras
title Casos de Uso — Paquete 3: Proveedores y Compras

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing true
skinparam linetype polyline
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam titleFontSize 16
skinparam titleFontColor #1F3B5B
skinparam packageStyle folder
skinparam packageBorderColor #CA6F1E
skinparam packageFontColor #1F3B5B
skinparam packageFontStyle bold
skinparam actorBackgroundColor #FFFFFF
skinparam actorBorderColor #1F3B5B
skinparam actorFontColor #1F3B5B
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #CA6F1E
skinparam usecaseFontColor #333333
skinparam arrowColor #4A6A8A

actor "Encargado\nde Compras" as compras
actor "Encargado\nde Bodega" as bodega

package "Proveedores y Compras" #FDEBD0 {
  usecase "CU-O-11\nEmitir orden de compra" as UC11
  usecase "CU-O-12\nConsultar órdenes\nde compra" as UC12
  usecase "CU-O-13\nRegistrar recepción\nde mercancía" as UC13
  usecase "CU-O-14\nRegistrar pago\na proveedor" as UC14
}

actor "Gerente" as gerente

compras --> UC11
compras --> UC12
compras --> UC14

bodega --> UC13

UC12 <-- gerente
UC14 <-- gerente

@enduml
