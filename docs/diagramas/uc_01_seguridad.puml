@startuml uc_01_seguridad
title Casos de Uso — Paquete 1: Seguridad y Control de Acceso

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing true
skinparam linetype polyline
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam titleFontSize 16
skinparam titleFontColor #1F3B5B
skinparam packageStyle folder
skinparam packageBorderColor #A93226
skinparam packageFontColor #1F3B5B
skinparam packageFontStyle bold
skinparam actorBackgroundColor #FFFFFF
skinparam actorBorderColor #1F3B5B
skinparam actorFontColor #1F3B5B
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #A93226
skinparam usecaseFontColor #333333
skinparam arrowColor #4A6A8A

actor "Usuario\n(todos los roles)" as usuario
actor "Administrador" as admin

package "Seguridad y Control de Acceso" #F9E0E0 {
  usecase "CU-O-01\nIniciar sesión" as UC01
  usecase "CU-O-02\nRenovar sesión" as UC02
  usecase "CU-O-03\nCerrar sesión" as UC03
  usecase "CU-O-04\nGestionar usuarios y roles" as UC04
  usecase "CU-O-05\nConfigurar horarios de acceso" as UC05
}

usuario --> UC01
usuario --> UC02
usuario --> UC03

admin --> UC04
admin --> UC05

admin --|> usuario

@enduml
