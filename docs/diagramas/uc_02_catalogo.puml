@startuml uc_02_catalogo
title Casos de Uso — Paquete 2: Catálogo

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing true
skinparam linetype polyline
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam titleFontSize 16
skinparam titleFontColor #1F3B5B
skinparam packageStyle folder
skinparam packageBorderColor #2E5A88
skinparam packageFontColor #1F3B5B
skinparam packageFontStyle bold
skinparam actorBackgroundColor #FFFFFF
skinparam actorBorderColor #1F3B5B
skinparam actorFontColor #1F3B5B
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #2E5A88
skinparam usecaseFontColor #333333
skinparam arrowColor #4A6A8A

actor "Público\n(visitante)" as publico
actor "Cliente" as cliente
actor "Administrador" as admin

package "Catálogo" #DDEBF7 {
  usecase "CU-O-06\nConsultar catálogo" as UC06
  usecase "CU-O-07\nGestionar categorías" as UC07
  usecase "CU-O-08\nGestionar marcas" as UC08
  usecase "CU-O-09\nGestionar productos" as UC09
  usecase "CU-O-10\nGestionar variantes\ny atributos" as UC10
}

publico --> UC06
cliente --> UC06

admin --> UC07
admin --> UC08
admin --> UC09
admin --> UC10

@enduml
