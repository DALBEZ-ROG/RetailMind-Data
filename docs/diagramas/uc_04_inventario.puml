@startuml uc_04_inventario
title Casos de Uso — Paquete 4: Inventario y Bodegas

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing true
skinparam linetype polyline
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam titleFontSize 16
skinparam titleFontColor #1F3B5B
skinparam packageStyle folder
skinparam packageBorderColor #239B56
skinparam packageFontColor #1F3B5B
skinparam packageFontStyle bold
skinparam actorBackgroundColor #FFFFFF
skinparam actorBorderColor #1F3B5B
skinparam actorFontColor #1F3B5B
skinparam usecaseBackgroundColor #FFFFFF
skinparam usecaseBorderColor #239B56
skinparam usecaseFontColor #333333
skinparam arrowColor #4A6A8A

actor "Encargado\nde Bodega" as bodega
actor "Roles operativos\n(Vendedor, Compras,\nBodega, Analista...)" as operativos

package "Inventario y Bodegas" #DFF5E1 {
  usecase "CU-O-15\nTransferir stock\nentre bodegas" as UC15
  usecase "CU-O-16\nConsultar transferencias" as UC16
  usecase "CU-O-17\nConsultar existencias" as UC17
}

actor "Gerente" as gerente

bodega --> UC15
bodega --> UC16

operativos --> UC17

UC16 <-- gerente

@enduml
