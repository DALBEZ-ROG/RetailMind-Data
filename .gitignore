.claude/

# Kiro MCP config (contiene credenciales de conexion)
.kiro/settings/mcp.json

# Artefactos de build y datos locales (no versionar)
node_modules/
retailmind-backend/target/
retailmind-backend/logs/
retailmind-frontend/.angular/
retailmind-frontend/dist/
clickhouse-data/

# Secretos de despliegue (Docker secrets) y dump de migracion
deploy/secrets/
deploy/postgres/initdb/*.dump

deploy/postgres/.env

# Configuracion local con secretos (usar .env.example como plantilla)
.env
retailmind/.env

# Bytecode de Python (lo genera el ETL al correr dentro del contenedor,
# porque ./retailmind esta montado como volumen)
__pycache__/
*.pyc

# Secretos del modo desarrollo
application-local.properties
