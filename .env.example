# =====================================================================
# Plantilla de configuracion de RetailMind. Copiar a `.env` y rellenar.
#
#     cp .env.example .env
#
# `.env` NO debe versionarse (esta en .gitignore). Este archivo si: lleva
# las CLAVES sin los VALORES, para que quien clone sepa que hace falta.
# =====================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────
# Contrasenas de los dos roles con LOGIN. La del SUPERUSUARIO no va aqui:
# viaja por un secreto de Docker en `deploy/secrets/pg_superuser.txt`
# (la imagen admite POSTGRES_PASSWORD_FILE), porque una variable de
# entorno es visible en `docker inspect` y en `docker compose config`.
PG_APP_PASSWORD=          # rol `retailmind_app` (LOGIN, NOINHERIT)
PG_ETL_PASSWORD=          # rol `retailmind_etl` (LOGIN, BYPASSRLS, solo lectura)

# Puerto en el ANFITRION. EL CORTE (§9.6 del diseno) YA SE EJECUTO el
# 2026-08-03: el CONTENEDOR sirve en el 5432 y es la base VIVA, mientras
# el PostgreSQL local de Windows se movio al 5433. Dejar 5432 salvo que
# haya otro motor ocupandolo. Dentro de la red del compose los demas
# servicios usan siempre `postgres:5432`, asi que este valor solo afecta
# a lo que se conecta desde el anfitrion.
PG_PORT=5432

# La clave del SUPERUSUARIO se lee del secreto de Docker de arriba. Esta
# variable existe solo como ANULACION puntual, para los scripts que se
# ejecutan desde el anfitrion y necesitan escribir como `postgres`
# (`retailmind/matriz_*.py` ensanchan la ventana de `grupo_horario`, que es
# una escritura, y `retailmind_etl` es de solo lectura por construccion).
# Dejarla VACIA es lo normal: sin ella los scripts leen el secreto.
PG_SUPERUSER_PASSWORD=
PG_SUPERUSER_USER=postgres

# ── ClickHouse ────────────────────────────────────────────────────────
CH_HOST=clickhouse
CH_PORT=8123
CH_DATABASE=retailmind    # base LEGADA: `analytics/` la necesita por
                          # defecto. El almacen VIVO es `retailmind_dwh`
                          # y los informes lo cualifican explicitamente.
CH_USER=
CH_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────
# Rotarlo = 64 bytes aleatorios. El unico efecto es que los tokens
# vigentes caducan, irrelevante en una demostracion.
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ── Programacion del DWH ──────────────────────────────────────────────
# `-` DESACTIVA el @Scheduled del backend. Hay que ponerlo el dia que
# Airflow tome el relevo: si no, a las 02:00 disparan los dos y dos
# cargas concurrentes compiten por el `EXCHANGE TABLES` del mismo destino.
DWH_CRON=0 0 2 * * *

# ── ETL y scripts de verificacion (van en `retailmind/.env`) ──────────
# Estas NO las lee el compose: las lee el Python que corre DESDE EL
# ANFITRION — el pipeline (`etl/dwh/conexiones.py`) y los scripts de
# verificacion (`matriz_*.py`, `validar_tableros.py`). Se listan aqui
# porque `retailmind/.env` esta gitignored y no tiene plantilla propia.
# Ninguno de esos scripts trae valor por defecto: si falta una, fallan
# diciendo cual, en vez de conectarse al motor equivocado.
#
# ETL_PG_PORT=5432 es el CONTENEDOR. El PostgreSQL local esta en el 5433
# y NO es la base viva: apuntar ahi da cifras de una copia congelada.
# ETL_PG_USER=retailmind_etl es obligatorio, no una preferencia: es el
# unico rol con BYPASSRLS, y `pol_horario` esta declarada con `cmd = ALL`
# —ALL incluye SELECT—, asi que cualquier otro rol devuelve CERO FILAS en
# silencio y la verificacion daria «todo cuadra» sin haber leido nada.
#
# ETL_PG_HOST=localhost
# ETL_PG_PORT=5432
# ETL_PG_DATABASE=retailmind
# ETL_PG_USER=retailmind_etl
# ETL_PG_PASSWORD=            # el mismo valor que PG_ETL_PASSWORD
# ETL_CH_HOST=localhost
# ETL_CH_PORT=8123
# ETL_CH_DATABASE=retailmind_dwh   # el almacen VIVO, no la base legada
# ETL_CH_USER=default
# ETL_CH_PASSWORD=

# ── pgAdmin (perfil `tools`, opcional) ────────────────────────────────
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# ── Perfiles ──────────────────────────────────────────────────────────
# Descomentar PARA LA FERIA: hace que `docker compose up -d` levante los
# cuatro servicios y no solo postgres + clickhouse.
# Ojo: la primera build del backend es LENTA (compila pyarrow/pandas
# sobre Alpine). Hacerla con antelacion, nunca la vispera.
# COMPOSE_PROFILES=demo
